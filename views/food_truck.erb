<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Village Orchard Food Truck // Saratoga</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --orange:  #FF6200;
      --cyan:    #00E5FF;
      --yellow:  #FFE600;
      --dark:    #080808;
      --dark2:   #111111;
      --dark3:   #1A1A1A;
      --white:   #FFFFFF;
      --gray:    #888888;
      --radius:  4px;
      --font-hero: 'Arial Black', 'Arial Bold', 'Helvetica Neue', sans-serif;
      --font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    body {
      background: var(--dark);
      color: var(--white);
      font-family: var(--font-body);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ─── Nav ────────────────────────────────────────────────────────── */
    nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.25rem 2.5rem;
      background: linear-gradient(to bottom, rgba(8,8,8,0.95) 0%, transparent 100%);
    }

    .nav-logo {
      font-family: var(--font-hero);
      font-size: 1.1rem;
      font-weight: 900;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--white);
      text-decoration: none;
    }

    .nav-logo span { color: var(--orange); }

    .nav-links { display: flex; gap: 2rem; list-style: none; }

    .nav-links a {
      color: var(--gray);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--white); }

    /* ─── Hero ───────────────────────────────────────────────────────── */
    .hero {
      position: relative;
      padding: 6rem 2.5rem 4rem;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -20%;
      right: -10%;
      width: 70%;
      height: 140%;
      background: linear-gradient(135deg, transparent 40%, rgba(255,98,0,0.06) 40%,
                  rgba(255,98,0,0.10) 60%, transparent 60%);
      transform: skewX(-8deg);
      pointer-events: none;
    }

    .hero-eyebrow {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 1.25rem;
      position: relative; z-index: 1;
    }

    .hero-headline {
      font-family: var(--font-hero);
      font-weight: 900;
      font-size: clamp(2.5rem, 8vw, 6.5rem);
      line-height: 0.92;
      letter-spacing: -0.03em;
      text-transform: uppercase;
      position: relative; z-index: 1;
    }

    .hero-headline .accent-orange { color: var(--orange); }

    .hero-tagline {
      margin-top: 2rem;
      font-size: clamp(1rem, 2.5vw, 1.35rem);
      color: rgba(255,255,255,0.65);
      max-width: 48ch;
      line-height: 1.55;
      position: relative; z-index: 1;
    }

    .hero-tagline strong { color: var(--white); font-weight: 700; }

    /* ─── Stall details ──────────────────────────────────────────────── */
    .details {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      padding: 2rem 2.5rem 4rem;
      flex: 1;
    }

    .card {
      background: var(--dark2);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: var(--radius);
      padding: 2rem;
    }

    .card h2 {
      font-family: var(--font-hero);
      font-size: 0.85rem;
      font-weight: 900;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 1rem;
    }

    .card p { color: rgba(255,255,255,0.75); line-height: 1.6; }
    .card .big {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 0.5rem;
    }

    .menu-list { list-style: none; }
    .menu-list li {
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      color: rgba(255,255,255,0.8);
    }
    .menu-list li:last-child { border-bottom: 0; }
    .menu-list li::before {
      content: '—';
      color: var(--orange);
      margin-right: 0.6rem;
    }

    /* ─── Footer ─────────────────────────────────────────────────────── */
    footer {
      padding: 2rem 2.5rem;
      border-top: 1px solid rgba(255,255,255,0.06);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      color: var(--gray);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    footer a { color: var(--white); text-decoration: none; font-weight: 700; }
    footer a:hover { color: var(--orange); }

    .not-found { padding: 4rem 2.5rem; }
  </style>
</head>
<body>
  <nav aria-label="Main navigation">
    <a href="/" class="nav-logo">Saro<span>·</span>GA</a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/schema">Schema</a></li>
    </ul>
  </nav>

  <% if @food_truck && @orchard %>
    <header class="hero">
      <p class="hero-eyebrow">Village Orchard // Weekend Stall</p>
      <h1 class="hero-headline">
        <%= @food_truck.name.upcase.sub('FOOD TRUCK', '<span class="accent-orange">FOOD TRUCK</span>') %>
      </h1>
      <p class="hero-tagline">
        <%= @food_truck.notes %> — parked at <strong><%= @orchard.name %></strong>,
        <%= @orchard.location %> (est. <%= @orchard.established_year %>).
      </p>
    </header>

    <section class="details">
      <div class="card">
        <h2>On the Menu</h2>
        <ul class="menu-list">
          <% @food_truck.menu.to_s.split(',').map(&:strip).each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      </div>

      <div class="card">
        <h2>Featured Variety</h2>
        <% if (variety = @food_truck.specialty_variety) %>
          <p class="big"><%= variety.name %></p>
          <p><%= variety.notes %></p>
        <% else %>
          <p>Rotating selection from the block.</p>
        <% end %>
      </div>

      <div class="card">
        <h2>The Orchard</h2>
        <p class="big"><%= @orchard.name %></p>
        <p>
          Home block for <%= @orchard.varieties.map(&:name).join(', ') %>.
          Every menu item starts with fruit picked within sight of the truck.
        </p>
      </div>
    </section>
  <% else %>
    <p class="not-found">The Village Orchard food truck is not on site today.</p>
  <% end %>

  <footer>
    <span>Saratoga Orchards</span>
    <a href="/">Back to homepage</a>
  </footer>
</body>
</html>
