RACK_ENV=production
SARATOGA_ENV=production
SARATOGA_DATABASE_PATH=/app/data/saratoga.db
# Set this to a long random value through your deployment platform's secret store.
SARATOGA_API_TOKEN=
PORT=9292
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=5
MAX_REQUEST_BYTES=1048576
MAX_QUERY_BYTES=100000
MAX_BATCH_SIZE=20
MAX_SUBSCRIPTIONS=100
